+  dense?: boolean;
+
+  /**
+   * Fecha automaticamente o menu ao clicar.
+   *
+   * @default true
+   */
+  closeOnPress?: boolean;
+
+  onPress?: (event: GestureResponderEvent) => void;
+
+  containerStyle?: StyleProp<ViewStyle>;
+
+  contentStyle?: StyleProp<ViewStyle>;
+
+  titleStyle?: StyleProp<TextStyle>;
+
+  testID?: string;
+}
