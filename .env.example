# Required by the NestJS API.
# Replace these placeholders before starting the containers.
RIOT_API_KEY=replace-with-your-riot-api-key
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
ACCESS_TOKEN_VALIDITY_DURATION_IN_SEC=900

# Local ports exposed on the host.
API_PORT=3000
ADMIN_PORT=4200
MOBILE_WEB_PORT=8081
MONGO_PORT=27017

# Browser origins allowed by the API (comma-separated).
CORS_ORIGIN=http://localhost:4200,http://localhost:8081
API_PREFIX=api

# Optional: pin a Data Dragon version for repeatable local builds.
# Empty means the preparation script fetches the latest published version.
DDRAGON_VERSION=
